# Discord Bot Configuration
# Obtain these from the Discord Developer Portal: https://discord.com/developers/applications

# Found under: General Information -> Application ID
DISCORD_APPLICATION_ID=your_application_id_here

# Found under: General Information -> Public Key
DISCORD_PUBLIC_KEY=your_public_key_here

# Found under: Bot -> Reset Token / Copy Token (Used by `npm run register` to register /megumi)
DISCORD_BOT_TOKEN=your_bot_token_here

# Optional: Server / Guild ID for instant command registration during testing
# If omitted, `npm run register` registers /megumi globally across all servers
# DISCORD_GUILD_ID=your_test_guild_id_here

# Python Renderer API Configuration
# The public URL to your Python REST API endpoint (e.g. https://api.yourdomain.com/megumi)
RENDER_API_URL=https://api.yourdomain.com/megumi

# Optional: Bearer token or secret key if your Python API requires authentication
# RENDER_API_KEY=your_secret_key_here

