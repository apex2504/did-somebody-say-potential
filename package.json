{
  "name": "megumi-discord-bot",
  "version": "1.0.0",
  "description": "Discord bot on Cloudflare Workers for generating Megumi text memes",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build:assets": "node scripts/build-assets.js",
    "build": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "register": "node scripts/register.js"
  },
  "keywords": [
    "discord-bot",
    "cloudflare-workers",
    "interactions",
    "megumi"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord-interactions": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
